{
  "id": "/",
  "name": "NEXUS",
  "short_name": "NEXUS",
  "description": "NEXUS CloudSecOps Command Center",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "window-controls-overlay"],
  "background_color": "#080d18",
  "theme_color": "#080d18",
